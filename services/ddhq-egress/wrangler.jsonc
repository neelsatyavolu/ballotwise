{
  "name": "ballotwise-ddhq-egress",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "containers": [
    { "class_name": "VotesContainer", "image": "./Dockerfile", "instance_type": "lite", "max_instances": 1 }
  ],
  "durable_objects": {
    "bindings": [{ "name": "VOTES", "class_name": "VotesContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VotesContainer"] }]
}
