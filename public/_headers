# https://developers.cloudflare.com/workers/static-assets/headers
# Build chunks have content-hashed names, so they never change.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Map shapes keep their names across deploys but rarely change: served from cache, refreshed in the background.
/midterms/maps/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

# Candidate headshots keep their names across deploys and rarely change: same treatment as the map shapes.
/midterms/photos/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

# Past-results summaries and the map's worker keep their names across deploys and rarely change: same treatment.
/midterms/past/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800
/midterms/vendor/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800
