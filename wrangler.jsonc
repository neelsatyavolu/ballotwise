{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ballotwise",
  "main": "custom-worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "ballotwise" }],
  "routes": [
    { "pattern": "ballotwise.xanom.co", "custom_domain": true },
    // Old address; custom-worker.ts redirects it to the new one.
    { "pattern": "ballotwise.n3el.dev", "custom_domain": true }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "ballotwise", "database_id": "a1ff97bd-8cbf-4b4c-8aa8-7efba6a6891e", "migrations_dir": "migrations" }
  ],
  "queues": {
    "producers": [{ "binding": "RESEARCH_QUEUE", "queue": "ballotwise-research" }],
    // Up to 4 jobs per invocation, run side by side (custom-worker.ts), so a ballot's races start together
    // rather than waiting on the queue to scale up. 4 x 6 caps parallel races to stay clear of Grok's rate limits.
    "consumers": [{ "queue": "ballotwise-research", "max_batch_size": 4, "max_batch_timeout": 1, "max_concurrency": 6, "max_retries": 3 }]
  },
  // Re-rates the midterm races from market prices and polls (custom-worker.ts `scheduled`).
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": { "APP_URL": "https://ballotwise.xanom.co" },
  "observability": { "enabled": true }
}
